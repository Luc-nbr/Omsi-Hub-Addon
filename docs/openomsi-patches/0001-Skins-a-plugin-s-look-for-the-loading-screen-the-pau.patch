+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A skin's map colours go over the palette it names them for, the rest as they were; no
+    /// skin, the palettes themselves.
+    #[test]
+    fn a_skin_colours_the_map() {
+        let navy = Color::hex(0x0a142e);
+        assert_eq!(set_skin(&[], &[("land", navy), ("lava", navy)]), vec!["lava".to_string()]);
+        assert_eq!(palette(false).land, navy);
+        assert_eq!(palette(false).road, DARK.road);
+        assert_eq!(palette(true).land, LIGHT.land);
+        set_skin(&[], &[]);
+        assert_eq!(palette(false).land, DARK.land);
+    }
+}
