diff --git a/crates/omsi-app/src/skin.rs b/crates/omsi-app/src/skin.rs
new file mode 100644
index 0000000..9a97cf2
--- /dev/null
+++ b/crates/omsi-app/src/skin.rs
@@ -0,0 +1,343 @@
+//! A skin: another look for the game's own screens, brought by a folder plugin
+//! (`plugins/<name>/skin.json`, see docs/PLUGINS.md "Skins") and chosen with `skin=<name>` in
+//! the settings or `--skin <name>`. It gives the theme's colours (`omsi_ui::theme`: the
+//! widget kit, the pause menu, the photo and developer panels), the loading screen's logo,
+//! colours and tips, the pause menu's name and mark and lines of the plugin's own in it (a
+//! click on one is the plugin's `menu_entry` event), and the navigator's map colours
+//! (`omsi_mapdraw::style`). It is read once, before the window opens; one that cannot be read
+//! is said in the log and the game keeps its own look.
+
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, RwLock};
+
+use omsi_ui::Color;
+use serde_json::Value;
+
+/// The most lines a skin adds to the pause menu, and the most tips it gives.
+const MAX_ENTRIES: usize = 6;
+const MAX_TIPS: usize = 40;
+/// A picture of a skin, at most (a PNG's or JPEG's bytes).
+const MAX_PICTURE: u64 = 4 * 1024 * 1024;
+
+/// A picture of the skin: an SVG drawn at the size it is shown at, or a picture's pixels.
+#[derive(Clone)]
+pub(crate) enum Picture {
+    Svg(String),
+    Rgba { w: u32, h: u32, px: Vec<u8> },
+}
+
+impl Picture {
+    /// Its width over its height.
+    pub(crate) fn aspect(&self) -> f32 {
+        match self {
+            Picture::Svg(src) => omsi_ui::icons::svg_size(src).map_or(1.0, |(w, h)| w / h.max(1e-3)),
+            Picture::Rgba { w, h, .. } => *w as f32 / (*h).max(1) as f32,
+        }
+    }
+
+    /// Its pixels fitted into `w` x `h` (straight RGBA, as the interface's textures are).
+    pub(crate) fn pixels(&self, w: u32, h: u32) -> Option<Vec<u8>> {
+        match self {
+            Picture::Svg(src) => omsi_ui::icons::rasterize_rgba(src, w, h),
+            Picture::Rgba { w: pw, h: ph, px } => {
+                let img = image::RgbaImage::from_raw(*pw, *ph, px.clone())?;
+                Some(image::imageops::resize(&img, w.max(1), h.max(1), image::imageops::FilterType::Triangle).into_raw())
+            }
+        }
+    }
+}
+
+/// A line of the pause menu the skin adds: its id (`skin:<id>`, what the plugin hears), its
+/// text and its icon, and the line it comes after (None: before "End the session").
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Entry {
+    pub id: &'static str,
+    pub label: &'static str,
+    pub icon: &'static str,
+    pub after: Option<String>,
+}
+
+/// What a skin changes.
+#[derive(Clone, Default)]
+pub(crate) struct Skin {
+    /// The plugin (its folder's name).
+    pub plugin: String,
+    /// The name in the pause menu's sidebar, in place of "openOMSI".
+    pub title: Option<String>,
+    /// The theme's colours by name (`omsi_ui::theme::SWATCHES`).
+    pub colours: Vec<(String, Color)>,
+    /// The loading screen.
+    pub logo: Option<Picture>,
+    pub background: Option<Color>,
+    pub map_name: Option<Color>,
+    pub text: Option<Color>,
+    /// The bar's two stripes (the same twice: plain) and its track.
+    pub bar: Option<(Color, Color)>,
+    pub track: Option<Color>,
+    /// (made static once, as they are read: the loading screen's tips are the game's texts)
+    pub tips: Vec<&'static str>,
+    /// Only the skin's tips (else they are shown among the game's).
+    pub tips_only: bool,
+    /// The pause menu's mark (a square beside the name) and its lines.
+    pub mark: Option<Picture>,
+    pub entries: Vec<Entry>,
+    /// The map's colours, over the light and the dark palettes.
+    pub map_light: Vec<(String, Color)>,
+    pub map_dark: Vec<(String, Color)>,
+}
+
+static CURRENT: RwLock<Option<Arc<Skin>>> = RwLock::new(None);
+
+/// The skin in use, if any.
+pub(crate) fn current() -> Option<Arc<Skin>> {
+    CURRENT.read().ok().and_then(|s| s.clone())
+}
+
+/// The skin chosen (`--skin`, else the settings' `skin`) read from the plugins' folders and put
+/// in use; none chosen, or none to be found, the game's own look.
+pub(crate) fn load(arg: Option<&str>) {
+    let settings = crate::settings::Settings::load().skin;
+    let name = arg.map(str::trim).filter(|n| !n.is_empty()).unwrap_or(settings.trim()).to_string();
+    if name.is_empty() {
+        return;
+    }
+    let dirs: Vec<PathBuf> = omsi_cfg::content_roots()
+        .iter()
+        .filter(|r| !omsi_cfg::is_sandbox(r))
+        .filter_map(|r| omsi_plugin::resolve_path(r, "plugins"))
+        .filter(|d| d.is_dir())
+        .collect();
+    match find(&dirs, &name).map(|d| read(&d, &name)) {
+        Some(Ok(skin)) => {
+            log::info!("skin: {} ({})", skin.title.as_deref().unwrap_or(&skin.plugin), skin.plugin);
+            set(Some(skin));
+        }
+        Some(Err(e)) => log::warn!("skin {name}: {e}; the game's own look"),
+        None => log::warn!("skin {name}: no plugins/{name}/skin.json; the game's own look"),
+    }
+}
+
+/// The folder of plugin `name` that has a skin, in the first plugins folder that has it.
+fn find(dirs: &[PathBuf], name: &str) -> Option<PathBuf> {
+    // (a folder's name only: nothing that reaches out of the plugins folder)
+    if name.contains(['/', '\\', '.']) {
+        return None;
+    }
+    dirs.iter().map(|d| d.join(name)).find(|d| d.join("skin.json").is_file())
+}
+
+/// `skin` in use (its colours given to the theme and the map), or none: the game's own look.
+pub(crate) fn set(skin: Option<Skin>) {
+    let skin = skin.map(Arc::new);
+    let colours: Vec<(&str, Color)> = skin.as_ref().map(|s| s.colours.iter().map(|(k, c)| (k.as_str(), *c)).collect()).unwrap_or_default();
+    for k in omsi_ui::theme::set_skin_colours(&colours) {
+        log::warn!("skin: the theme has no colour \"{k}\"");
+    }
+    fn pairs(v: Option<&Vec<(String, Color)>>) -> Vec<(&str, Color)> {
+        v.map(|v| v.iter().map(|(k, c)| (k.as_str(), *c)).collect()).unwrap_or_default()
+    }
+    let (light, dark) = (pairs(skin.as_ref().map(|s| &s.map_light)), pairs(skin.as_ref().map(|s| &s.map_dark)));
+    for k in omsi_mapdraw::style::set_skin(&light, &dark) {
+        log::warn!("skin: the map has no colour \"{k}\"");
+    }
+    if let Ok(mut c) = CURRENT.write() {
+        *c = skin;
+    }
+}
+
+/// `#RRGGBB` or `#RRGGBBAA`.
+fn colour(v: &Value) -> Option<Color> {
+    let s = v.as_str()?.trim().strip_prefix('#')?;
+    if !s.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return None;
+    }
+    let n = |k: usize| u8::from_str_radix(&s[k..k + 2], 16).ok();
+    match s.len() {
+        6 => Some(Color::rgba(n(0)?, n(2)?, n(4)?, 1.0)),
+        8 => Some(Color::rgba(n(0)?, n(2)?, n(4)?, n(6)? as f32 / 255.0)),
+        _ => None,
+    }
+}
+
+/// A text, or a table of texts by language (`{"en": ..., "nl": ...}`): the game's language's,
+/// else English, else the first.
+fn text(v: &Value) -> Option<String> {
+    match v {
+        Value::String(s) => Some(s.clone()),
+        Value::Object(m) => {
+            let lang = omsi_ui::i18n::language();
+            let lang = if lang.is_empty() { "en".to_string() } else { lang };
+            m.get(&lang).or_else(|| m.get("en")).or_else(|| m.values().next()).and_then(Value::as_str).map(str::to_string)
+        }
+        _ => None,
+    }
+    .map(|s| s.chars().filter(|c| !c.is_control()).take(200).collect::<String>().trim().to_string())
+    .filter(|s| !s.is_empty())
+}
+
+/// A picture of the plugin's folder (an SVG, PNG, JPEG, BMP or TGA), never outside it.
+fn picture(dir: &Path, rel: &str) -> Result<Picture, String> {
+    if rel.contains("..") || Path::new(rel).is_absolute() {
+        return Err(format!("{rel}: outside the plugin's folder"));
+    }
+    let p = omsi_plugin::resolve_path(dir, rel).ok_or_else(|| format!("{rel}: not there"))?;
+    if std::fs::metadata(&p).map_or(true, |m| m.len() > MAX_PICTURE) {
+        return Err(format!("{rel}: not there, or larger than 4 MB"));
+    }
+    if rel.to_ascii_lowercase().ends_with(".svg") {
+        let src = std::fs::read_to_string(&p).map_err(|e| format!("{rel}: {e}"))?;
+        omsi_ui::icons::svg_size(&src).ok_or_else(|| format!("{rel}: not an SVG that can be read"))?;
+        return Ok(Picture::Svg(src));
+    }
+    let img = image::open(&p).map_err(|e| format!("{rel}: {e}"))?.to_rgba8();
+    Ok(Picture::Rgba { w: img.width(), h: img.height(), px: img.into_raw() })
+}
+
+/// Colours by name (`{"accent": "#2A75F7", ...}`).
+fn colours(v: Option<&Value>, what: &str) -> Result<Vec<(String, Color)>, String> {
+    let Some(v) = v else { return Ok(Vec::new()) };
+    let m = v.as_object().ok_or_else(|| format!("{what}: not a table of colours"))?;
+    m.iter().map(|(k, c)| colour(c).map(|c| (k.clone(), c)).ok_or_else(|| format!("{what}.{k}: not a colour (#RRGGBB or #RRGGBBAA)"))).collect()
+}
+
+/// The skin of plugin `name` in folder `dir` (its `skin.json`).
+pub(crate) fn read(dir: &Path, name: &str) -> Result<Skin, String> {
+    let text_of = std::fs::read_to_string(dir.join("skin.json")).map_err(|e| format!("skin.json: {e}"))?;
+    parse(dir, name, &text_of)
+}
+
+/// The skin of `json`, its pictures in `dir`.
+pub(crate) fn parse(dir: &Path, name: &str, json: &str) -> Result<Skin, String> {
+    let v: Value = serde_json::from_str(json).map_err(|e| format!("skin.json: {e}"))?;
+    let mut skin = Skin { plugin: name.to_string(), title: v.get("title").and_then(text), colours: colours(v.get("colours"), "colours")?, ..Default::default() };
+    if let Some(l) = v.get("loading") {
+        let c = |k: &str| l.get(k).map(|x| colour(x).ok_or_else(|| format!("loading.{k}: not a colour"))).transpose();
+        skin.background = c("background")?;
+        skin.map_name = c("map_name")?;
+        skin.text = c("text")?;
+        skin.track = c("track")?;
+        skin.bar = match l.get("bar") {
+            None => None,
+            Some(Value::Array(a)) if a.len() == 2 => Some((colour(&a[0]).ok_or("loading.bar: not a colour")?, colour(&a[1]).ok_or("loading.bar: not a colour")?)),
+            Some(x) => colour(x).map(|c| (c, c)).ok_or("loading.bar: a colour, or two for the stripes")?.into(),
+        };
+        if let Some(logo) = l.get("logo").and_then(Value::as_str) {
+            skin.logo = Some(picture(dir, logo)?);
+        }
+        skin.tips = l.get("tips").and_then(Value::as_array).map(|a| a.iter().filter_map(text).take(MAX_TIPS).map(|t| &*Box::leak(t.into_boxed_str())).collect()).unwrap_or_default();
+        skin.tips_only = l.get("tips_only").and_then(Value::as_bool).unwrap_or(false) && !skin.tips.is_empty();
+    }
+    if let Some(m) = v.get("menu") {
+        if let Some(mark) = m.get("mark").and_then(Value::as_str) {
+            skin.mark = Some(picture(dir, mark)?);
+        }
+        for e in m.get("entries").and_then(Value::as_array).into_iter().flatten().take(MAX_ENTRIES) {
+            let id = e.get("id").and_then(Value::as_str).filter(|id| !id.is_empty() && id.len() <= 32 && id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-'));
+            let (Some(id), Some(label)) = (id, e.get("label").and_then(text)) else {
+                return Err("menu.entries: each one needs an id (letters, digits, _ and -) and a label".into());
+            };
+            // (the menu's lines are the game's static texts: a skin's are made so once, as it is read)
+            let leak = |s: String| -> &'static str { Box::leak(s.into_boxed_str()) };
+            skin.entries.push(Entry {
+                id: leak(format!("skin:{id}")),
+                label: leak(label),
+                icon: leak(e.get("icon").and_then(Value::as_str).unwrap_or("chevron_right").to_string()),
+                after: e.get("after").and_then(Value::as_str).map(str::to_string),
+            });
+        }
+    }
+    skin.map_light = colours(v.get("map_light"), "map_light")?;
+    skin.map_dark = colours(v.get("map_dark"), "map_dark")?;
+    Ok(skin)
+}
+
+/// The game menu's lines with the skin's put in: each after the line it names (one it does
+/// not find, or none named: before the way out).
+pub(crate) fn menu_lines(lines: &mut Vec<(&'static str, &'static str)>) {
+    if let Some(skin) = current() {
+        put_lines(&skin, lines);
+    }
+}
+
+fn put_lines(skin: &Skin, lines: &mut Vec<(&'static str, &'static str)>) {
+    for e in &skin.entries {
+        let at = e
+            .after
+            .as_deref()
+            .and_then(|a| lines.iter().position(|l| l.0 == a).map(|k| k + 1))
+            .or_else(|| lines.iter().position(|l| l.0 == "quit"))
+            .unwrap_or(lines.len());
+        lines.insert(at, (e.id, e.label));
+    }
+}
+
+/// The icon of a skin's line of the pause menu.
+pub(crate) fn icon_of(id: &str) -> Option<&'static str> {
+    current()?.entries.iter().find(|e| e.id == id).map(|e| e.icon)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn dir(tag: &str) -> PathBuf {
+        let d = std::env::temp_dir().join(format!("openomsi-skin-{tag}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&d);
+        std::fs::create_dir_all(d.join("skin")).unwrap();
+        d
+    }
+
+    const MARK: &str = r##"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 50"><rect width="200" height="50" fill="#2a75f7"/></svg>"##;
+
+    /// A skin's colours, loading screen, menu lines and map colours, read as written.
+    #[test]
+    fn a_skin_is_read_as_it_is_written() {
+        let d = dir("read");
+        std::fs::write(d.join("skin/logo.svg"), MARK).unwrap();
+        let json = r##"{
+            "title": "Omsi-Hub",
+            "colours": { "accent": "#2A75F7", "bg": "#0A142ECC" },
+            "loading": { "logo": "skin/logo.svg", "background": "#0A142E", "bar": ["#2A75F7", "#5B95F9"], "tips": ["One", {"en": "Two", "nl": "Twee"}], "tips_only": true },
+            "menu": { "mark": "skin/logo.svg", "entries": [{ "id": "duty", "label": "My duty", "icon": "badge", "after": "resume" }, { "id": "company", "label": "Company" }] },
+            "map_dark": { "land": "#0A142E" }
+        }"##;
+        let s = parse(&d, "omsihub", json).unwrap();
+        assert_eq!(s.title.as_deref(), Some("Omsi-Hub"));
+        assert_eq!(s.colours[0], ("accent".to_string(), Color::rgba(42, 117, 247, 1.0)));
+        assert!((s.colours[1].1 .0[3] - 0.8).abs() < 1e-3);
+        assert_eq!(s.bar, Some((Color::rgba(42, 117, 247, 1.0), Color::rgba(91, 149, 249, 1.0))));
+        assert_eq!(s.tips, vec!["One", "Two"]);
+        assert!(s.tips_only);
+        assert!((s.logo.as_ref().unwrap().aspect() - 4.0).abs() < 1e-3);
+        assert_eq!(s.logo.as_ref().unwrap().pixels(80, 20).map(|p| p.len()), Some(80 * 20 * 4));
+        assert_eq!(s.entries[0], Entry { id: "skin:duty", label: "My duty", icon: "badge", after: Some("resume".into()) });
+        assert_eq!(s.entries[1].icon, "chevron_right");
+        assert_eq!(s.map_dark, vec![("land".to_string(), Color::rgba(10, 20, 46, 1.0))]);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// What cannot be used is said, and nothing outside the plugin's folder is read.
+    #[test]
+    fn a_skin_that_cannot_be_used_says_why() {
+        let d = dir("bad");
+        assert!(parse(&d, "x", "{").err().unwrap().starts_with("skin.json"));
+        assert!(parse(&d, "x", r#"{"colours": {"accent": "blue"}}"#).err().unwrap().contains("colours.accent"));
+        assert!(parse(&d, "x", r#"{"loading": {"logo": "../../secret.png"}}"#).err().unwrap().contains("outside"));
+        assert!(parse(&d, "x", r#"{"loading": {"logo": "skin/none.svg"}}"#).err().unwrap().contains("not there"));
+        assert!(parse(&d, "x", r#"{"menu": {"entries": [{"id": "a b", "label": "x"}]}}"#).is_err());
+        assert!(find(&[d.clone()], "../x").is_none());
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// The skin's lines go in after the line each names, else before the way out.
+    #[test]
+    fn the_skin_s_lines_go_into_the_menu() {
+        let d = dir("menu");
+        let s = parse(&d, "p", r#"{"menu": {"entries": [{"id": "duty", "label": "My duty", "after": "resume"}, {"id": "company", "label": "Company"}]}}"#).unwrap();
+        let mut lines: Vec<(&'static str, &'static str)> = vec![("resume", "Resume"), ("options", "Options..."), ("quit", "End the session")];
+        put_lines(&s, &mut lines);
+        assert_eq!(lines.iter().map(|l| l.0).collect::<Vec<_>>(), ["resume", "skin:duty", "options", "skin:company", "quit"]);
+        assert_eq!(s.entries[1].label, "Company");
+        let _ = std::fs::remove_dir_all(&d);
+    }
+}
