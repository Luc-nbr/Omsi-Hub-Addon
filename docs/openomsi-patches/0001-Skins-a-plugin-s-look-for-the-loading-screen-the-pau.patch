+/// The colours above by the names a skin gives them (`skin.json`'s `colours`, see
+/// docs/PLUGINS.md "Skins"), each read through a function of the same name in lower case:
+/// the skin's colour when it has one, else the constant. The game's own screens read them so
+/// (the widget kit, the pause menu, the photo and developer panels).
+macro_rules! swatches {
+    ($($fun:ident = $konst:ident, $key:literal;)*) => {
+        /// The names of the colours a skin may give.
+        pub const SWATCHES: &[&str] = &[$($key),*];
+        $(
+            #[doc = concat!("[`", stringify!($konst), "`], or the skin's `", $key, "`.")]
+            #[inline]
+            pub fn $fun() -> Color {
+                live($key, $konst)
+            }
+        )*
+    };
+}
+
+swatches! {
+    accent = ACCENT, "accent";
+    accent_2 = ACCENT_2, "accent_2";
+    accent_hover = ACCENT_HOVER, "accent_hover";
+    accent_ink = ACCENT_INK, "accent_ink";
+    danger = DANGER, "danger";
+    danger_2 = DANGER_2, "danger_2";
+    ok = OK, "ok";
+    warn = WARN, "warn";
+    text = TEXT, "text";
+    text_soft = TEXT_SOFT, "text_soft";
+    text_dim = TEXT_DIM, "text_dim";
+    text_faint = TEXT_FAINT, "text_faint";
+    rail = RAIL, "rail";
+    panel = PANEL, "panel";
+    field = FIELD, "field";
+    hover = HOVER, "hover";
+    selected = SELECTED, "selected";
+    edge = EDGE, "edge";
+    bg = BG, "bg";
+    sidebar = SIDEBAR, "sidebar";
+    surface = SURFACE, "surface";
+    surface_2 = SURFACE_2, "surface_2";
+    surface_3 = SURFACE_3, "surface_3";
+    ink = INK, "ink";
+    ink_2 = INK_2, "ink_2";
+    ink_muted = INK_MUTED, "ink_muted";
+}
+
+/// The skin's colours, by name (none: the constants).
+static SKINNED: std::sync::RwLock<Vec<(&'static str, Color)>> = std::sync::RwLock::new(Vec::new());
+
+fn live(key: &str, default: Color) -> Color {
+    SKINNED.read().ok().and_then(|v| v.iter().find(|(k, _)| *k == key).map(|(_, c)| *c)).unwrap_or(default)
+}
+
+/// A skin's colours in place of the theme's (`[]`: the theme's own again). A name that is not
+/// one of [`SWATCHES`] is left aside; it is returned, for the skin's loader to say so.
+pub fn set_skin_colours(colours: &[(&str, Color)]) -> Vec<String> {
+    let mut unknown = Vec::new();
+    let mut kept = Vec::new();
+    for (name, c) in colours {
+        match SWATCHES.iter().find(|k| **k == *name) {
+            Some(k) => kept.push((*k, *c)),
+            None => unknown.push(name.to_string()),
+        }
+    }
+    if let Ok(mut v) = SKINNED.write() {
+        *v = kept;
+    }
+    unknown
+}
