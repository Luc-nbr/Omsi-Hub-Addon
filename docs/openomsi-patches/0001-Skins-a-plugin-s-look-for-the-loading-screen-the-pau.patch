+            "wall_lit" => &mut self.wall_lit,
+            "wall_dark" => &mut self.wall_dark,
+            "shadow" => &mut self.shadow,
+            "tree" => &mut self.tree,
+            "tree_edge" => &mut self.tree_edge,
+            "rail" => &mut self.rail,
+            "rail_dash" => &mut self.rail_dash,
+            "tram" => &mut self.tram,
+            "route" => &mut self.route,
+            "route_edge" => &mut self.route_edge,
+            "driven" => &mut self.driven,
+            "card" => &mut self.card,
+            "card_text" => &mut self.card_text,
+            "card_dim" => &mut self.card_dim,
+            "label" => &mut self.label,
+            "label_halo" => &mut self.label_halo,
+            "contour" => &mut self.contour,
+            _ => return false,
+        };
+        *slot = c;
+        true
+    }
+}
+
+/// A skin's map colours over the light and the dark palettes (`skin.json`'s `map_light` and
+/// `map_dark`), or none (both empty: the palettes as they are). The names a palette does not
+/// have are returned, for the skin's loader to say so.
+pub fn set_skin(light: &[(&str, Color)], dark: &[(&str, Color)]) -> Vec<String> {
+    let mut unknown = Vec::new();
+    let mut made = |base: &Palette, colours: &[(&str, Color)]| {
+        let mut p = *base;
+        for (name, c) in colours {
+            if !p.set(name, *c) {
+                unknown.push(name.to_string());
+            }
+        }
+        p
+    };
+    let skinned = (!light.is_empty() || !dark.is_empty()).then(|| {
+        let l: &'static Palette = Box::leak(Box::new(made(&LIGHT, light)));
+        let d: &'static Palette = Box::leak(Box::new(made(&DARK, dark)));
+        (l, d)
+    });
+    if let Ok(mut s) = SKINNED.write() {
+        *s = skinned;
+    }
+    unknown
+}
+
 /// Traffic on a road: free (the route's own blue), slow, heavy, standing.
 pub const TRAFFIC: [Color; 4] = [hex(0x2f7cf6), hex(0xff9f0a), hex(0xff453a), hex(0xa4161a)];
 
 /// Which way the shadows fall, per metre of height (world, x east, y north): the light comes
 /// from the north-west, as on a printed map lit from its top left corner.
 pub const SHADOW_DIR: [f32; 2] = [0.34, -0.28];
