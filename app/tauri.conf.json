{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omsi-Hub",
  "mainBinaryName": "omsi-hub",
  "version": "0.1.0",
  "identifier": "com.omsihub.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: hub: http://hub.localhost; connect-src 'self' ipc: http://ipc.localhost hub: http://hub.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Luc-nbr/Omsi-Hub-Addon/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Omsi-Hub",
    "homepage": "https://omsihub.com",
    "copyright": "Copyright (c) Omsi-Hub",
    "category": "SimulationGame",
    "shortDescription": "The add-on for openOMSI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
